# Export these through your service manager; this file is never automatically loaded.
OPENAI_API_KEY=
# Choose an API model that supports Responses and web_search; no default is assumed.
OPENAI_MODEL=
# Generate a stable random secret of at least 32 characters; do not commit it.
COOKIE_SECRET=
# REQUIRED: administrator-supplied daily allowance and conservative maximum USD
# cost per request, including input/output, reasoning and one web-search call.
APP_DAILY_BUDGET_USD=
REQUEST_MAX_COST_USD=
OPENAI_BASE_URL=https://api.openai.com/v1
WEB_SEARCH_ENABLED=1
RATE_LIMIT_PER_MINUTE=6
IP_DAILY_LIMIT=20
# Absolute path on persistent disk (default server/quota.sqlite3)
# QUOTA_DB_PATH=/var/lib/comparison/quota.sqlite3
# Exact origins; separate by commas. Required for deployment through a proxy.
# ALLOWED_ORIGINS=https://example.org
# Exact addresses of reverse proxies permitted to supply X-Forwarded-For.
# TRUSTED_PROXIES=127.0.0.1
